---
import { siteConfig } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import BackToTop from '../components/BackToTop.astro';
import ImageZoom from '../components/ImageZoom.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  wide?: boolean;
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = '/images/flybit-design-system.svg',
  wide = false,
  noindex = false,
} = Astro.props;

const siteBase = 'https://flybit.fun';
const rawPath = Astro.url.pathname.split('?')[0].split('#')[0];
const normalizedPath = rawPath === '/' ? '/' : (rawPath.endsWith('/') ? rawPath : `${rawPath}/`);
const canonicalURL = new URL(normalizedPath, siteBase).href;
const pageTitle = title === siteConfig.title ? `${siteConfig.title} — ${siteConfig.tagline}` : `${title} | ${siteConfig.title}`;
const ogImageURL = new URL(image, canonicalURL).href;

const features = siteConfig.features ?? {};
const showSearch = features.search !== false;
const showBackToTop = features.backToTop !== false;
const showImageZoom = features.imageZoom !== false;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><circle cx=%2250%22 cy=%2250%22 r=%2246%22 fill=%22%2310b981%22/><path d=%22M52 18 L28 54 L48 54 L44 82 L72 46 L52 46 Z%22 fill=%22%23ffffff%22/></svg>" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={new URL('/rss.xml', siteBase)} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />

    <script is:inline>
      if (typeof document !== 'undefined' && document.cookie.includes('googtrans')) {
        const host = window.location.hostname;
        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=' + host + ';';
        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.' + host + ';';
      }
    </script>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Search Engine Verifications (Google, Bing, Baidu, Shenma) -->
    {siteConfig.verifications?.google && <meta name="google-site-verification" content={siteConfig.verifications.google} />}
    {siteConfig.verifications?.bing && <meta name="msvalidate.01" content={siteConfig.verifications.bing} />}
    {siteConfig.verifications?.baidu && <meta name="baidu-site-verification" content={siteConfig.verifications.baidu} />}
    {siteConfig.verifications?.shenma && <meta name="shenma-site-verification" content={siteConfig.verifications.shenma} />}

    <!-- Organization & WebSite Linked Entity Schema -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://flybit.fun/#organization",
          "name": siteConfig.title,
          "url": "https://flybit.fun/",
          "logo": "https://flybit.fun/images/flybit-design-system.svg",
          "description": siteConfig.description
        },
        {
          "@type": "WebSite",
          "@id": "https://flybit.fun/#website",
          "url": "https://flybit.fun/",
          "name": siteConfig.title,
          "description": siteConfig.description,
          "publisher": { "@id": "https://flybit.fun/#organization" },
          "inLanguage": "zh-CN"
        }
      ]
    })} />

    <!-- Anti-FOUC script: Executed synchronously before DOM render -->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem('flybit_theme') || 'slate';
        document.documentElement.setAttribute('data-theme', savedTheme);
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <Header />
    <main id="main-content" class:list={['main-content', wide ? 'container-wide' : 'container']}>
      <slot />
    </main>
    <Footer />
    {showSearch && <SearchModal />}
    {showBackToTop && <BackToTop />}
    {showImageZoom && <ImageZoom />}
  </body>
</html>

<style>
  .main-content {
    flex: 1;
    padding-bottom: 3.5rem;
  }
</style>
