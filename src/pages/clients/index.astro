---
// src/pages/clients/index.astro
// Cross-Platform Proxy Clients Center & Tutorials
import BaseLayout from '../../layouts/BaseLayout.astro';
import { platformGuides } from '../../data/clients';
---

<BaseLayout
  title="2026 全平台机场代理客户端大全 — Clash、Shadowrocket、v2rayN 下载与导入教程"
  description="涵盖 Windows、Android、iOS、macOS、Linux、OpenWrt 软路由全平台代理客户端下载与配置。提供 Clash Verge Rev、Shadowrocket 小火箭、v2rayNG、OpenClash 一键导入与规则分流实操指南。"
>
  <div class="clients-page">
    <!-- Header -->
    <header class="clients-header">
      <div class="badge-row">
        <span class="live-dot"></span>
        <span class="badge-text">CLIENT OBSERVATORY // CROSS-PLATFORM PROXY HUB</span>
      </div>
      <h1 class="page-title">2026 全平台机场代理客户端推荐与配置指南</h1>
      <p class="page-desc">
        无论您使用的是 Windows 电脑、安卓手机、苹果 iPhone / Mac 还是家庭软路由，我们均为您整理了主流开源、经过安全审计的高性能代理客户端。
      </p>

      <!-- Platform Quick Jump Bar -->
      <div class="quick-nav-bar">
        {platformGuides.map((guide) => (
          <a href={`#${guide.id}`} class="quick-nav-pill">
            <span class="qnp-icon">{guide.icon}</span>
            <span class="qnp-title">{guide.title.split(' ')[0]}</span>
          </a>
        ))}
      </div>
    </header>

    <!-- Platform Sections Loop -->
    <div class="platforms-container">
      {platformGuides.map((guide) => (
        <section class="platform-section" id={guide.id}>
          <!-- Section Header -->
          <div class="platform-head">
            <div class="ph-left">
              <span class="ph-icon">{guide.icon}</span>
              <div>
                <h2 class="ph-title">{guide.title}</h2>
                <p class="ph-intro">{guide.intro}</p>
              </div>
            </div>
          </div>

          <!-- 4-Step Subscription Import Guide -->
          <div class="import-steps-box">
            <h3 class="isb-title">🚀 {guide.title.split(' ')[0]} 订阅导入 4 步极速上手：</h3>
            <div class="steps-grid">
              {guide.importSteps.map((step) => (
                <div class="step-card">
                  <div class="step-num">{step.step}</div>
                  <div class="step-body">
                    <strong>{step.title}</strong>
                    <p>{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Clients Grid -->
          <div class="clients-grid">
            {guide.clients.map((client) => (
              <div class:list={['client-card', { 'client-featured': client.featured }]}>
                <div class="cc-head">
                  <div class="cc-left">
                    <h3 class="cc-name">{client.name}</h3>
                    <span class="cc-cat">{client.category}</span>
                  </div>
                  {client.badge && <span class="cc-badge">{client.badge}</span>}
                </div>

                <p class="cc-desc">{client.description}</p>

                <!-- Protocols & Features -->
                <div class="cc-features">
                  <div class="cc-label">核心特性：</div>
                  <ul class="feat-list">
                    {client.features.map((f) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                </div>

                <div class="cc-protocols">
                  <span class="cc-proto-label">协议支持:</span>
                  {client.protocols.map((proto) => (
                    <span class="cc-proto-tag">{proto}</span>
                  ))}
                </div>

                <!-- Tutorial Tip -->
                <div class="cc-tutorial-box">
                  <span>💡 <strong>使用技巧：</strong>{client.tutorialSummary}</span>
                </div>

                <!-- Actions -->
                <div class="cc-foot">
                  <a
                    href={client.githubOrSiteUrl}
                    target="_blank"
                    rel="nofollow noopener"
                    class="cc-dl-btn"
                  >
                    前往下载 / 项目发布页 ↗
                  </a>
                </div>
              </div>
            ))}
          </div>

          <!-- SEO Keywords Cloud -->
          <div class="seo-keywords-box">
            <span class="sk-label">相关检索词：</span>
            <div class="sk-list">
              {guide.seoKeywords.map((kw) => (
                <span class="sk-tag">{kw}</span>
              ))}
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Troubleshooting & Safety FAQ -->
    <section class="safety-faq-section">
      <h2 class="faq-section-title">🛡️ 代理客户端安全与常见故障排查</h2>
      <div class="faq-grid">
        <div class="faq-card">
          <h3>Q: 什么是 TUN 模式？为什么有些软件不用代理也能生效？</h3>
          <p>
            A: TUN 模式通过创建虚拟网络适配器（虚拟网卡），在操作系统网络层接管所有进出流量。相比传统的“系统代理（仅支持浏览器等遵循系统 HTTP 代理的应用）”，TUN 模式可以无缝代理命令行终端（Git、npm、curl）、游戏客户端及各类非标准代理软件。
          </p>
        </div>
        <div class="faq-card">
          <h3>Q: 什么是规则分流（Rule / Config）？为什么要开启？</h3>
          <p>
            A: 规则分流是现代代理工具的核心。客户端内置数万条规则库，访问国内网站（百度、淘宝、微信、B站等）时自动直连，不走代理、不耗费机场流量且延迟最低；仅当访问海外受限服务（Google、YouTube、ChatGPT）时才自动走海外专线。
          </p>
        </div>
        <div class="faq-card">
          <h3>Q: 怎么防止 DNS 污染与 WebRTC IP 泄漏？</h3>
          <p>
            A: 推荐使用开启 Fake-IP 模式的 Mihomo 内核客户端（如 Clash Verge Rev、FlClash、OpenClash）。Fake-IP 避免了本地解析海外域名遭运营商 DNS 投毒，结合加密 DoH / DoT 上游服务器，确保真实 IP 与请求隐私不外泄。
          </p>
        </div>
        <div class="faq-card">
          <h3>Q: 苹果手机（iOS）在 App Store 搜不到小火箭怎么办？</h3>
          <p>
            A: 由于区域审核，Shadowrocket（小火箭）未在中国大陆 App Store 上架。请使用美区或香港区域 Apple ID 登录 App Store 即可正常搜索购买下载（切勿在手机“设置”的 iCloud 中登录未知账号）。
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .clients-page {
    padding: 1.5rem 0 3.5rem;
    max-width: 1040px;
    margin: 0 auto;
  }

  .clients-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .badge-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .page-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 820px;
    margin: 0 auto 2rem;
  }

  .quick-nav-bar {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .quick-nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .quick-nav-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  /* Platform Sections */
  .platforms-container {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin-bottom: 4rem;
  }

  .platform-section {
    scroll-margin-top: 5rem;
    border-top: 2px solid var(--border);
    padding-top: 2.5rem;
  }

  .platform-head {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .ph-left {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .ph-icon {
    font-size: 2.4rem;
    line-height: 1;
  }

  .ph-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 0.4rem;
    letter-spacing: -0.01em;
  }

  .ph-intro {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* Import Steps */
  .import-steps-box {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .isb-title {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .step-card {
    display: flex;
    gap: 0.65rem;
  }

  .step-num {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-body strong {
    display: block;
    font-size: 0.85rem;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .step-body p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* Clients Grid */
  .clients-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .client-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .client-card.client-featured {
    border-color: var(--accent);
    box-shadow: 0 4px 16px rgba(56, 189, 248, 0.08);
  }

  .cc-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .cc-name {
    margin: 0 0 0.2rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
  }

  .cc-cat {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .cc-badge {
    background: #0284c7;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .cc-desc {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .cc-features {
    font-size: 0.82rem;
  }

  .cc-label {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.35rem;
  }

  .feat-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--text-muted);
  }

  .cc-protocols {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .cc-proto-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .cc-proto-tag {
    font-size: 0.72rem;
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-family: var(--font-mono);
    color: var(--text);
  }

  .cc-tutorial-box {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.5rem 0.75rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .cc-tutorial-box strong {
    color: var(--text);
  }

  .cc-foot {
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .cc-dl-btn {
    display: inline-flex;
    align-items: center;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .cc-dl-btn:hover {
    text-decoration: underline;
  }

  /* SEO Keywords Cloud */
  .seo-keywords-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.85rem;
    background: var(--bg);
    border: 1px dashed var(--border);
    border-radius: 6px;
  }

  .sk-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .sk-tag {
    font-size: 0.72rem;
    color: var(--text-muted);
    background: var(--bg-surface);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  /* FAQ */
  .safety-faq-section {
    border-top: 2px solid var(--border);
    padding-top: 2.5rem;
  }

  .faq-section-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 1.5rem;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .faq-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
  }

  .faq-card h3 {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
  }

  .faq-card p {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .clients-grid {
      grid-template-columns: 1fr;
    }
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .steps-grid {
      grid-template-columns: 1fr;
    }
    .page-title {
      font-size: 1.8rem;
    }
  }
</style>
