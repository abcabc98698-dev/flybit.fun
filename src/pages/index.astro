---
// src/pages/index.astro
// Flybit Network Observatory Dashboard
import BaseLayout from '../layouts/BaseLayout.astro';
import AirportCard from '../components/AirportCard.astro';
import SpeedtestMetricBar from '../components/SpeedtestMetricBar.astro';
import { airportsData } from '../data/airports';
import { platformGuides } from '../data/clients';

const top1Guangsu = airportsData.find((b) => b.rank === 1)!;
const top10Brands = airportsData.filter((b) => b.rank >= 2 && b.rank <= 10);
const testedCount = airportsData.filter((b) => b.speedtestImage).length;
---

<BaseLayout
  title="Flybit 机场测评实验室 — 2026 42家主流机场实测监控与科学选购指南"
  description="Flybit 网络实验室（flybit.fun）专注于 2026 主流机场专线节点实测、4K流媒体与 ChatGPT/Claude 解锁监控、优惠码整理与全平台客户端配置指南。中立硬核，拒绝云测评。"
>
  <!-- NOC Observatory Header Hero -->
  <section class="noc-hero">
    <div class="hero-status-pill">
      <span class="live-pulse"></span>
      <span class="status-txt">NOC OBSERVATORY // 2026 晚高峰网络实测就绪</span>
      <span class="version-tag">PROBE v2.4</span>
    </div>

    <h1 class="hero-headline">
      42 家主流机场真机实测数据台<br />
      <span class="headline-gradient">告别玄学云测评，用延迟与吞吐说话</span>
    </h1>

    <p class="hero-subtext">
      Flybit 实验室（flybit.fun）以网络工程视角深度实测 42 家机场品牌。涵盖晚高峰抗封锁压力、4K 奈飞/迪士尼解锁、ChatGPT 5 与 Claude 3.5 原生访问监控。所有数据源自真实抓包与测速记录。
    </p>

    <!-- Stat Grid -->
    <div class="stat-grid">
      <div class="stat-card">
        <span class="stat-num">42</span>
        <span class="stat-label">主流机场深度建档</span>
      </div>
      <div class="stat-card">
        <span class="stat-num">{testedCount}</span>
        <span class="stat-label">真实晚高峰测速截图</span>
      </div>
      <div class="stat-card">
        <span class="stat-num">100%</span>
        <span class="stat-label">全平台客户端导入指南</span>
      </div>
      <div class="stat-card">
        <span class="stat-num">&lt; 25ms</span>
        <span class="stat-label">旗舰专线香港最低延迟</span>
      </div>
    </div>
  </section>

  <!-- Top 1 Flagship Push: 光速云 Exclusive Console -->
  <section class="flagship-section" id="featured">
    <div class="section-tag">
      <span class="tag-flag">🏆 2026 本站实验室 No.1 顶级主力推荐</span>
    </div>

    <div class="flagship-console">
      <div class="flagship-main">
        <div class="flagship-header">
          <div class="badge-row">
            <span class="flagship-badge">TOP 1 综合旗舰</span>
            <span class="snooker-badge">致敬斯诺克 147 永久套餐</span>
            <span class="line-badge">IEPL + 企业级内网专线</span>
          </div>
          <h2 class="flagship-title">
            <a href={`/brands/${top1Guangsu.id}`}>光速云 (GuangSu Cloud)</a>
          </h2>
          <p class="flagship-desc">
            {top1Guangsu.description}
          </p>
        </div>

        <!-- Metric Display from tests -->
        {top1Guangsu.speedtests && (
          <SpeedtestMetricBar
            brandName="光速云 (GuangSu Cloud)"
            testedAt="2026 晚高峰实测 (21:15)"
            metrics={top1Guangsu.speedtests}
            imageSrc={top1Guangsu.speedtestImage}
          />
        )}

        <!-- Highlights Grid -->
        <div class="highlights-grid">
          <div class="hl-item">
            <span class="hl-icon">⚡</span>
            <div>
              <strong>最高 2.5Gbps 带宽</strong>
              <p>原生稳定节点，全节点 1 倍率 IPLC 极速传输，4K 秒开拖拽零缓冲。</p>
            </div>
          </div>
          <div class="hl-item">
            <span class="hl-icon">🎱</span>
            <div>
              <strong>斯诺克 147 永久版</strong>
              <p>¥147 一次性买断 247GB 永久有效高速流量，不限设备，拒绝按月续费焦虑。</p>
            </div>
          </div>
          <div class="hl-item">
            <span class="hl-icon">🤖</span>
            <div>
              <strong>AI & 流媒体满血支持</strong>
              <p>ChatGPT 5 / Claude 3.5 Sonnet / TikTok 直播及跨境电商原生 IP 深度优化。</p>
            </div>
          </div>
          <div class="hl-item">
            <span class="hl-icon">💰</span>
            <div>
              <strong>超低入门成本</strong>
              <p>年付轻量版折合仅 ¥8/月（¥99/年 69GB/月），极速版 ¥25/月 168GB。</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Flagship Sidebar Action Box -->
      <div class="flagship-sidebar">
        <div class="pricing-card-spotlight">
          <span class="spotlight-title">光速云专属优惠方案</span>
          <div class="spotlight-price">
            <span class="currency">¥</span>
            <span class="amount">8</span>
            <span class="unit">/ 月 起</span>
          </div>
          <div class="spotlight-features">
            <div class="s-feat">✓ 2020 年稳定运营至今</div>
            <div class="s-feat">✓ IEPL 内网专线 + 全球 IPLC</div>
            <div class="s-feat">✓ 独创 147 元永久套餐</div>
            <div class="s-feat">✓ 自研客户端 + 全平台通用订阅</div>
          </div>

          <!-- Coupon Module -->
          <div class="flagship-coupon">
            <span class="f-coupon-label">新用户立减优惠码</span>
            <div class="f-coupon-box">
              <code class="f-code">AMM</code>
              <button
                type="button"
                class="f-copy-btn"
                onclick="navigator.clipboard.writeText('AMM').then(() => { this.innerText = '已复制!'; setTimeout(() => this.innerText = '复制', 2000); })"
              >
                复制
              </button>
            </div>
          </div>

          <!-- CTA Buttons -->
          <a
            href={top1Guangsu.affLink}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="flagship-cta-btn"
            title="直通光速云官方网站（含推广推荐）"
          >
            🚀 直通光速云官网注册
          </a>

          <a href={`/brands/${top1Guangsu.id}`} class="flagship-sub-btn">
            查看光速云完整测评与测速图 →
          </a>

          <div class="sidebar-disclosure">
            🛡️ 推广透明声明：本站专属优惠码 [AMM] 享官方折减，注册带推广参数不影响实际支付价格。
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Top 10 High Performance Matrix Section -->
  <section class="section-container" id="top10">
    <div class="section-head">
      <div>
        <h2 class="section-title">🏆 2026 梯队高分机场推荐 (Top 2 ~ 10)</h2>
        <p class="section-desc">基于延迟稳定性、晚高峰抗 QoS 封锁能力及流媒体解锁率的第二至第十名推荐</p>
      </div>
      <a href="/brands" class="view-all-link">查看完整 42 家机场品牌库 →</a>
    </div>

    <div class="airports-grid">
      {top10Brands.map((brand) => (
        <AirportCard brand={brand} />
      ))}
    </div>
  </section>

  <!-- Speedtest Showcase Teaser -->
  <section class="speedtest-teaser-section">
    <div class="teaser-inner">
      <div class="teaser-content">
        <span class="teaser-badge">实测实验室</span>
        <h2 class="teaser-title">17 家主流机场真实晚高峰测速大图</h2>
        <p class="teaser-desc">
          我们拒绝无图云测评。所有报告均配备高清 PhotoSwipe 交互式灯箱放大查看，真实呈现三大运营商晚高峰下的真实下行带宽、丢包率与 TLS RTT 握手耗时。
        </p>
        <a href="/speedtest" class="teaser-btn">
          进入测速实测大厅查验原图 →
        </a>
      </div>
      <div class="teaser-preview">
        <div class="preview-chart-box">
          <div class="chart-header-line">
            <span>OBSERVATORY_SPEEDTEST_SAMPLE.RAW</span>
            <span class="chart-tag">PNG 4K</span>
          </div>
          <div class="preview-img-frame">
            <img src="/images/speedtests/光速云-节点测速实测.png" alt="光速云节点测速实测预览" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Center Teaser -->
  <section class="section-container" id="clients">
    <div class="section-head">
      <div>
        <h2 class="section-title">💻 跨平台通用客户端与订阅导入指南</h2>
        <p class="section-desc">适配 Windows、Android、iOS、macOS、Linux 及 OpenWrt 软路由的全平台代理生态</p>
      </div>
      <a href="/clients" class="view-all-link">进入客户端中心 →</a>
    </div>

    <div class="clients-quick-grid">
      {platformGuides.map((guide) => (
        <a href={`/clients#${guide.id}`} class="client-quick-card">
          <div class="cq-icon">{guide.icon}</div>
          <div class="cq-body">
            <h3 class="cq-title">{guide.title}</h3>
            <p class="cq-desc">{guide.intro.slice(0, 48)}...</p>
            <div class="cq-tags">
              {guide.clients.slice(0, 2).map((c) => (
                <span class="cq-chip">{c.name}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Neutral Methodology & Compliance Disclaimer -->
  <section class="compliance-box">
    <h3 class="comp-title">🛡️ Flybit 实验室客观评测准则与商业披露</h3>
    <div class="comp-text">
      <p>
        1. <strong>评测独立性承诺：</strong>本站所有测速数据与解锁检测均在真实千兆家庭宽带及移动网络环境下完成，绝不接受任何服务商付费修改测速数据或篡改评测结论的要求。
      </p>
      <p>
        2. <strong>合规与推广分成披露：</strong>根据 FTC 与全球互联网透明度指引，本站部分外链包含 Affiliate 推广代码（已严格采用 <code>rel="nofollow sponsored noopener"</code> 标准规范）。当您通过链接注册或使用优惠码时，我们可能获得微薄佣金用以维持独立测速服务器与宽带开销，这不会增加您的任何付款金额，且往往能享受到专属立减。
      </p>
      <p>
        3. <strong>服务商变动提示：</strong>网络代理行业具有波动性，各品牌套餐、IPLC/IEPL 线路与优惠码可能随时发生变更。本站提供“实测数据（measured）”、“官方宣称（vendor）”与“历史归档（historical）”明确标注，购买前请务必前往官网复核即时说明。
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* NOC Hero */
  .noc-hero {
    padding: 3rem 0 2rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .hero-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .live-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .version-tag {
    color: var(--accent);
    font-weight: 700;
  }

  .hero-headline {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--text);
    margin: 0 auto 1.25rem;
    max-width: 850px;
  }

  .headline-gradient {
    background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtext {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 760px;
    margin: 0 auto 2.5rem;
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .stat-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stat-num {
    font-size: 1.6rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  /* Flagship Push Section */
  .flagship-section {
    margin-bottom: 3.5rem;
  }

  .section-tag {
    margin-bottom: 0.75rem;
  }

  .tag-flag {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: #0284c7;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
  }

  .flagship-console {
    background: var(--bg-surface);
    border: 2px solid #0284c7;
    border-radius: 12px;
    padding: 1.75rem;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    box-shadow: 0 12px 36px rgba(2, 132, 199, 0.15);
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .flagship-badge {
    background: #0284c7;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .snooker-badge {
    background: #7c3aed;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .line-badge {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .flagship-title {
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .flagship-title a {
    color: var(--text);
    text-decoration: none;
  }

  .flagship-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0 0 1.25rem;
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .hl-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .hl-icon {
    font-size: 1.35rem;
  }

  .hl-item strong {
    display: block;
    font-size: 0.9rem;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .hl-item p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* Flagship Sidebar */
  .pricing-card-spotlight {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
  }

  .spotlight-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    text-align: center;
  }

  .spotlight-price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.2rem;
  }

  .currency {
    font-size: 1.4rem;
    font-weight: 700;
    color: #10b981;
  }

  .amount {
    font-size: 2.8rem;
    font-weight: 900;
    font-family: var(--font-mono);
    color: #10b981;
    line-height: 1;
  }

  .unit {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .spotlight-features {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--text);
  }

  .flagship-coupon {
    background: rgba(56, 189, 248, 0.08);
    border: 1px dashed var(--accent);
    border-radius: 6px;
    padding: 0.6rem;
    text-align: center;
  }

  .f-coupon-label {
    display: block;
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .f-coupon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }

  .f-code {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .f-copy-btn {
    background: var(--accent);
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 0.2rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
  }

  .flagship-cta-btn {
    display: block;
    text-align: center;
    background: #0284c7;
    color: #ffffff;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.4);
    transition: background 0.15s ease;
  }

  .flagship-cta-btn:hover {
    background: #0369a1;
  }

  .flagship-sub-btn {
    display: block;
    text-align: center;
    font-size: 0.82rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .flagship-sub-btn:hover {
    color: var(--accent);
  }

  .sidebar-disclosure {
    font-size: 0.68rem;
    color: var(--text-muted);
    line-height: 1.35;
    text-align: center;
    opacity: 0.8;
  }

  /* Section Container */
  .section-container {
    margin-bottom: 3.5rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .section-title {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 0.35rem;
    color: var(--text);
  }

  .section-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0;
  }

  .view-all-link {
    font-size: 0.88rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .airports-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* Speedtest Teaser */
  .speedtest-teaser-section {
    background: #0b1120;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 2.25rem;
    margin-bottom: 3.5rem;
  }

  .teaser-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  .teaser-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #10b981;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid #10b981;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }

  .teaser-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.85rem;
    letter-spacing: -0.02em;
  }

  .teaser-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0 0 1.5rem;
  }

  .teaser-btn {
    display: inline-flex;
    align-items: center;
    background: #10b981;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.65rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.15s ease;
