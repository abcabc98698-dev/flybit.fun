---
// src/pages/jichang/index.astro
// 机场推荐核心栏目聚合支柱页 (Category Pillar: Airport Recommendations)
import BaseLayout from '../../layouts/BaseLayout.astro';
import { airportsData } from '../../data/airports';

const topBrands = airportsData.filter((b) => b.rank <= 6);
const ieplBrands = airportsData.filter((b) => b.lines.includes('IEPL') || b.lines.includes('IPLC')).slice(0, 4);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://flybit.fun/' },
    { '@type': 'ListItem', position: 2, name: '机场推荐', item: 'https://flybit.fun/jichang/' }
  ]
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '2026 机场推荐大盘 — 42家主流专线机场晚高峰实测与选购指南',
  description: '基于 Flybit 实验室晚高峰 1000M 宽带真机实测数据，精选 2026 高性价比与抗封锁专线机场。',
  url: 'https://flybit.fun/jichang/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: topBrands.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: b.name,
      url: `https://flybit.fun/brands/${b.id}/`
    }))
  }
};
---

<BaseLayout
  title="2026 机场推荐大盘 — 42家主流专线机场晚高峰实测与选购指南 | Flybit 实验室"
  description="基于 Flybit 实验室晚高峰 1000M 宽带真机实测数据，精选 2026 高性价比与抗封锁专线机场。深入对比 IEPL 内网专线、BGP 智能中转、流媒体 4K 与 ChatGPT 解锁表现。"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <div class="category-page">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/">首页</a>
      <span class="bc-sep">/</span>
      <span class="bc-current">机场推荐</span>
    </nav>

    <!-- Header Hero -->
    <header class="category-header">
      <div class="header-pill">
        <span class="live-pulse"></span>
        <span>LAB BENCHMARK // 机场推荐专栏</span>
      </div>
      <h1 class="page-title">2026 机场推荐大盘：真机晚高峰实测、专线对比与选购指南</h1>
      <p class="page-lead">
        拒绝主观云测评与黑盒推广。Flybit 实验室立足于晚高峰（20:30~22:30）千兆家庭宽带环境，对主流机场进行多轮高并发丢包率、TLS RTT 延迟及流媒体解锁压测，为您呈现真实客观的科学选购方案。
      </p>

      <!-- Quick Category Jump -->
      <div class="sub-nav-pills">
        <a href="#featured" class="snp-item active">🔥 晚高峰首选梯队</a>
        <a href="#iepl" class="snp-item">🛡️ 纯物理专线专区</a>
        <a href="#comparison" class="snp-item">📊 线路架构选型表</a>
        <a href="#guide" class="snp-item">💡 避坑选购法则</a>
        <a href="/brands" class="snp-item highlight">🏢 浏览全部 42 家品牌库 →</a>
      </div>
    </header>

    <!-- Section 1: Featured Brands -->
    <section class="cat-section" id="featured">
      <div class="section-head">
        <h2 class="section-title">🔥 晚高峰实验室精选评测服务商</h2>
        <span class="section-tag">TOP TESTED</span>
      </div>
      <p class="section-desc">
        以下服务商在最近 30 天连续压力监控中，晚高峰香港、日本节点 ICMP 探针丢包率均低于 0.8%，且支持 4K 奈飞与 ChatGPT 原生住宅 IP 访问。
      </p>

      <div class="brands-grid">
        {topBrands.map((brand) => (
          <article class="brand-card">
            <div class="bc-header">
              <div class="bc-title-wrap">
                <span class="bc-rank">#{String(brand.rank).padStart(2, '0')}</span>
                <h3 class="bc-name">{brand.name} {brand.alias && <small>({brand.alias})</small>}</h3>
              </div>
              <span class="bc-price">{brand.entryPrice}</span>
            </div>

            <div class="bc-meta-row">
              <span class="bc-line-badge">{brand.lines}</span>
              <span class="bc-proto-badge">{brand.protocols.slice(0, 2).join(' / ')}</span>
              {brand.startedYear && <span class="bc-year-badge">{brand.startedYear} 运营</span>}
            </div>

            <p class="bc-desc">{brand.description}</p>

            <div class="bc-unlock-tags">
              <span class="utag">🎬 Netflix 4K</span>
              <span class="utag">🤖 ChatGPT 5</span>
              <span class="utag">⚡ 4K 秒开</span>
            </div>

            <div class="bc-footer">
              <a href={`/brands/${brand.id}`} class="btn-detail">查看实测报告 →</a>
              {brand.affLink && (
                <a href={brand.affLink} target="_blank" rel="nofollow sponsored noopener" class="btn-aff">官网直达</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Section 2: Pure IEPL / IPLC Private Lines -->
    <section class="cat-section" id="iepl">
      <div class="section-head">
        <h2 class="section-title">🛡️ 纯物理专线（IEPL / IPLC）高稳专区</h2>
        <span class="section-tag">ENTERPRISE GRADE</span>
      </div>
      <p class="section-desc">
        专线流量端到端在二层内网闭环传输，不经过公网骨干网络跳点，无惧敏感时期的国际出口拥塞与重置，适合远程开发、SSH 运维与海外交易。
      </p>

      <div class="iepl-grid">
        {ieplBrands.map((b) => (
          <div class="iepl-item">
            <h3>{b.name}</h3>
            <div class="iepl-spec">
              <span><strong>线路拓扑：</strong>{b.lines}</span>
              <span><strong>入门门槛：</strong>{b.entryPrice}</span>
              <span><strong>节点覆盖：</strong>{b.nodesSummary}</span>
            </div>
            <p>{b.pros[0] || b.description}</p>
            <a href={`/brands/${b.id}`} class="iepl-link">深度评测报告 →</a>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 3: Architecture Comparison -->
    <section class="cat-section" id="comparison">
      <div class="section-head">
        <h2 class="section-title">📊 常见跨境网络传输架构深度对比</h2>
        <span class="section-tag">ARCHITECTURE</span>
      </div>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>传输架构</th>
              <th>骨干拓扑特点</th>
              <th>晚高峰稳定性</th>
              <th>延迟 (Ping)</th>
              <th>适用场景</th>
              <th>推荐预算</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>IEPL 内网专线</strong></td>
              <td>物理过境租用链路，端到端不走公网</td>
              <td>★★★★★ (丢包 &lt; 0.5%)</td>
              <td>极低且无抖动 (30~45ms)</td>
              <td>远程办公、游戏加速、大模型高频调用</td>
              <td>¥30 ~ ¥80 / 月</td>
            </tr>
            <tr>
              <td><strong>BGP 智能多线中转</strong></td>
              <td>国内多线机房汇聚，隧道过境直连落地</td>
              <td>★★★★☆ (丢包 1%~3%)</td>
              <td>低延迟，偶有峰值抖动</td>
              <td>日常网页、4K 视频、流媒体影音追剧</td>
              <td>¥12 ~ ¥30 / 月</td>
            </tr>
            <tr>
              <td><strong>普通直连公网 (CN2/直连)</strong></td>
              <td>公网直接出境，受国际出口 QoS 调控</td>
              <td>★★☆☆☆ (晚高峰拥塞明显)</td>
              <td>波动剧烈，丢包可达 15%+</td>
              <td>轻量备用、临时应急查阅资料</td>
              <td>¥5 ~ ¥15 / 月</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 4: Selection Guide -->
    <section class="cat-section" id="guide">
      <div class="section-head">
        <h2 class="section-title">💡 实验室选购四步决策法则</h2>
        <span class="section-tag">METHODOLOGY</span>
      </div>
      <div class="guide-steps-grid">
        <div class="step-card">
          <div class="step-num">01</div>
          <h3>明确业务主场景</h3>
          <p>看视频追求大流量性价比，首选 BGP 中转；写代码、跑 API 或玩美服游戏，首选物理 IEPL 专线。</p>
        </div>
        <div class="step-card">
          <div class="step-num">02</div>
          <h3>坚持月付防跑路</h3>
          <p>无论商家优惠力度多大，新机场尽量坚持月付或季付。严防年付“大促销”后失联跑路。</p>
        </div>
        <div class="step-card">
          <div class="step-num">03</div>
          <h3>关注落地 IP 洁净度</h3>
          <p>需要解锁 ChatGPT 或 Netflix 的用户，重点检查节点是否具备原生住宅 IP 或定制 DNS 分流。</p>
        </div>
        <div class="step-card">
          <div class="step-num">04</div>
          <h3>配置主备双机场</h3>
          <p>永远准备一个按量付费或低成本备用节点池，避免单点故障导致工作断连。</p>
        </div>
      </div>
    </section>

    <!-- Related Topic Links -->
    <section class="cat-bottom-nav">
      <h3>探索更多专业专题与工具指南：</h3>
      <div class="cbn-links">
        <a href="/vpn">VPN 与加速专栏 →</a>
        <a href="/tizi">梯子防坑与稳定性 →</a>
        <a href="/clash">Clash Verge 全平台上手 →</a>
        <a href="/free">免费试用与安全沙盒 →</a>
        <a href="/radar">机场跑路风控雷达 →</a>
        <a href="/faq">常见疑难解答 50 问 →</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .category-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem 0 3.5rem;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .breadcrumb-nav a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb-nav a:hover {
    color: var(--accent);
  }

  .bc-sep {
    color: var(--border);
  }

  .bc-current {
    color: var(--text);
    font-weight: 500;
  }

  /* Header */
  .category-header {
    margin-bottom: 3rem;
  }

  .header-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }

  .live-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 1rem;
  }

  .page-lead {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 860px;
    margin: 0 0 1.75rem;
  }

  .sub-nav-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .snp-item {
    font-size: 0.85rem;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .snp-item:hover, .snp-item.active {
    border-color: #10b981;
    color: #10b981;
  }

  .snp-item.highlight {
    background: rgba(16, 185, 129, 0.15);
    border-color: rgba(16, 185, 129, 0.4);
    color: #10b981;
    font-weight: 600;
  }

  /* Section */
  .cat-section {
    margin-bottom: 3.5rem;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }

  .section-tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .section-desc {
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* Brands Grid */
  .brands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .brand-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, border-color 0.2s;
  }

  .brand-card:hover {
    transform: translateY(-2px);
    border-color: rgba(16, 185, 129, 0.4);
  }

  .bc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .bc-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bc-rank {
    font-size: 0.8rem;
    font-weight: 700;
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .bc-name {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
    color: var(--text);
  }

  .bc-name small {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .bc-price {
    font-size: 1.05rem;
    font-weight: 700;
    color: #10b981;
  }

  .bc-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.85rem;
  }

  .bc-line-badge, .bc-proto-badge, .bc-year-badge {
    font-size: 0.75rem;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .bc-line-badge {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border-color: rgba(56, 189, 248, 0.25);
  }

  .bc-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0 0 1rem;
    flex: 1;
  }

  .bc-unlock-tags {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .utag {
    font-size: 0.75rem;
    background: rgba(16, 185, 129, 0.08);
    color: #10b981;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .bc-footer {
    display: flex;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .btn-detail {
    flex: 1;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text);
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-detail:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .btn-aff {
    flex: 1;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem;
    background: #10b981;
    color: #fff;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .btn-aff:hover {
    opacity: 0.9;
  }

  /* IEPL Grid */
  .iepl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .iepl-item {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .iepl-item h3 {
    font-size: 1.1rem;
    margin: 0 0 0.75rem;
    color: var(--text);
  }

  .iepl-spec {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .iepl-item p {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0 0 1rem;
    flex: 1;
  }

  .iepl-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: #10b981;
    text-decoration: none;
  }

  /* Table */
  .table-wrap {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .data-table th, .data-table td {
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
  }

  .data-table th {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
    font-weight: 600;
  }

  .data-table td {
    color: var(--text-muted);
  }

  .data-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  /* Guide Steps */
  .guide-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.25rem;
  }

  .step-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 800;
    color: #10b981;
    margin-bottom: 0.5rem;
  }

  .step-card h3 {
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
    color: var(--text);
  }

  .step-card p {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* Bottom Nav */
  .cat-bottom-nav {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }

  .cat-bottom-nav h3 {
    font-size: 1.1rem;
    color: var(--text);
    margin: 0 0 1rem;
  }

  .cbn-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cbn-links a {
    font-size: 0.9rem;
    color: #10b981;
    text-decoration: none;
    background: rgba(16, 185, 129, 0.08);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    transition: background 0.2s;
  }

  .cbn-links a:hover {
    background: rgba(16, 185, 129, 0.16);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 1.75rem;
    }
    .brands-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
