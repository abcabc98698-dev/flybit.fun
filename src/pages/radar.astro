    </section>

    <!-- Interactive 6-Dimension Health Calculator -->
    <section class="calculator-section" id="radar-tool">
      <div class="calc-header">
        <div class="calc-badge">INTERACTIVE RADAR TOOL</div>
        <h2>6 维机场健康度自测评分器</h2>
        <p>勾选你正在使用或正打算购买的机场的实际现状，系统将即时计算其综合风险指数并给出避雷建议：</p>
      </div>

      <div class="calc-body">
        <div class="factors-grid">
          <!-- Factor 1 -->
          <div class="factor-group">
