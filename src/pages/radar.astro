    </header>

    <!-- Quick Status Board -->
    <section class="status-summary-board-section">
      <h2 class="board-heading">2026 行业风险态势与健康度三大梯队</h2>
      <div class="status-summary-board">
        <div class="status-card safe">
          <div class="status-icon">🟢</div>
          <div class="status-info">
            <h3>行业稳健梯队</h3>
            <p>具备长约物理专线、合理月付定价与持续技术支持的老牌头部服务商，财务模型健康度良好。</p>
          </div>
        </div>
        <div class="status-card warning">
          <div class="status-icon">🟡</div>
