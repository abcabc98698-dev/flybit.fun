  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const selects = document.querySelectorAll('.factor-select');
      const scoreEl = document.getElementById('risk-score');
      const statusEl = document.getElementById('risk-status');
      const adviceEl = document.getElementById('risk-advice');
      const displayBox = document.getElementById('calc-result-display');

      function calculateRisk() {
        let total = 0;
        selects.forEach(sel => {
          total += parseInt(sel.value || '0', 10);
        });

        // Cap at 100
        if (total > 100) total = 100;
        if (scoreEl) scoreEl.innerText = total.toString();

        if (displayBox && statusEl && adviceEl) {
          displayBox.className = 'calc-result-box';
          if (total <= 25) {
            displayBox.classList.add('safe');
            statusEl.innerText = '🟢 稳健健康（极低风险）';
            statusEl.style.color = '#10b981';
            adviceEl.innerText = '该平台的各项指标均处于正常且健康的运营区间，财务模型合理，建议保持按月或按季正常使用。';
          } else if (total <= 55) {
            displayBox.classList.add('warning');
            statusEl.innerText = '🟡 观察预警（中度超售风险）';
            statusEl.style.color = '#f59e0b';
            adviceEl.innerText = '该平台存在一定程度的超售或营销反常迹象。坚决不要购买半年或年付套餐，建议严格保持月付体验，并备份备用节点。';
          } else {
            displayBox.classList.add('danger');
            statusEl.innerText = '🔴 红色高危（典型跑路前夕征兆）';
            statusEl.style.color = '#ef4444';
            adviceEl.innerText = '严重警告：该平台已命中多项行业跑路生死红线！极可能处于资金链即将断裂或最后敛财阶段，请立即停止续费，抓紧备份本地配置！';
          }
        }
      }

      selects.forEach(sel => sel.addEventListener('change', calculateRisk));
      calculateRisk();
    });
  </script>

