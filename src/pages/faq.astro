  <!-- Client-side Interactive Search & Accordion Logic -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('faq-search-input');
      const clearSearchBtn = document.getElementById('faq-clear-search');
      const tabBtns = document.querySelectorAll('.tab-btn');
      const faqCards = document.querySelectorAll('.faq-card');
      const emptyState = document.getElementById('faq-empty-state');
      const expandAllBtn = document.getElementById('faq-expand-all');
      const collapseAllBtn = document.getElementById('faq-collapse-all');

      let currentCategory = 'all';

      // Function to filter FAQs based on search and category
      function filterFaqs() {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        faqCards.forEach(card => {
          const category = card.getAttribute('data-category');
          const title = card.querySelector('.q-title')?.innerText.toLowerCase() || '';
          const body = card.querySelector('.answer-inner')?.innerText.toLowerCase() || '';

          const matchCat = (currentCategory === 'all' || category === currentCategory);
          const matchQuery = !query || title.includes(query) || body.includes(query);

          if (matchCat && matchQuery) {
            card.style.display = 'block';
            visibleCount++;
            // If search query is entered, auto expand matching cards for convenience
            if (query.length >= 2) {
              const btn = card.querySelector('.faq-question-btn');
              const panel = card.querySelector('.faq-answer-panel');
              btn?.setAttribute('aria-expanded', 'true');
              if (panel) panel.hidden = false;
            }
          } else {
            card.style.display = 'none';
          }
        });

        if (clearSearchBtn) {
          clearSearchBtn.style.display = query ? 'block' : 'none';
        }

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      // Search input handler with debounce
      let debounceTimer;
      searchInput?.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(filterFaqs, 150);
      });

      clearSearchBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        filterFaqs();
        searchInput?.focus();
      });

      // Tab Category Buttons
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tabBtns.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          currentCategory = btn.getAttribute('data-category') || 'all';
          filterFaqs();
        });
      });

      // Accordion Click Logic
      faqCards.forEach(card => {
        const btn = card.querySelector('.faq-question-btn');
        const panel = card.querySelector('.faq-answer-panel');

        btn?.addEventListener('click', () => {
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', (!isExpanded).toString());
          if (panel) panel.hidden = isExpanded;
        });
      });

      // Expand All
      expandAllBtn?.addEventListener('click', () => {
        faqCards.forEach(card => {
          if (card.style.display !== 'none') {
            const btn = card.querySelector('.faq-question-btn');
            const panel = card.querySelector('.faq-answer-panel');
            btn?.setAttribute('aria-expanded', 'true');
            if (panel) panel.hidden = false;
          }
        });
      });

      // Collapse All
      collapseAllBtn?.addEventListener('click', () => {
        faqCards.forEach(card => {
          const btn = card.querySelector('.faq-question-btn');
          const panel = card.querySelector('.faq-answer-panel');
          btn?.setAttribute('aria-expanded', 'false');
          if (panel) panel.hidden = true;
        });
      });
    });
  </script>

