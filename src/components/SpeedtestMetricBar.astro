---
// src/components/SpeedtestMetricBar.astro
// NOC Console Latency & Speed Metric Display (as defined in 机场品牌图表样式.txt)
import type { SpeedtestMetric } from '../data/airports';

interface Props {
  brandName: string;
  testedAt?: string;
  metrics: SpeedtestMetric[];
  imageSrc?: string;
}

const { brandName, testedAt = '2026 晚高峰实测 (20:30 - 22:30)', metrics, imageSrc } = Astro.props;

function getLatencyColor(latencyStr: string): string {
  const num = parseFloat(latencyStr);
  if (isNaN(num)) return '#10b981';
  if (num < 50) return '#10b981'; // Green: <50ms
  if (num < 100) return '#38bdf8'; // Cyan: 50-100ms
  if (num < 180) return '#eab308'; // Yellow: 100-180ms
  return '#f97316'; // Orange: >180ms
}

function calculateBarWidth(downloadStr: string): number {
  const num = parseFloat(downloadStr);
  if (isNaN(num)) return 75;
  // If in MB/s (100 MB/s max)
  if (downloadStr.includes('MB/s')) {
    return Math.min(100, Math.max(15, Math.round((num / 100) * 100)));
  }
  // If in Mbps (1000 Mbps max)
  return Math.min(100, Math.max(15, Math.round((num / 600) * 100)));
}
---

<div class="noc-terminal-box">
  <!-- Terminal Header -->
  <div class="terminal-bar">
    <div class="window-controls">
      <span class="ctrl-dot red"></span>
      <span class="ctrl-dot yellow"></span>
      <span class="ctrl-dot green"></span>
    </div>
    <div class="terminal-title">
      📡 NOC OBSERVATORY // {brandName} 晚高峰节点吞吐报告
    </div>
    <div class="terminal-badge">LIVE LAB</div>
  </div>

  <div class="terminal-sub">
    <span>测试环境: Clash Verge Rev (Mihomo 内核)</span>
    <span>•</span>
    <span>测速源: Speedtest.net 骨干节点</span>
    <span>•</span>
    <span>时间: {testedAt}</span>
  </div>

  <!-- Metric Rows -->
  <div class="metric-list">
    {metrics.map((m) => {
      const color = getLatencyColor(m.latency);
      const width = calculateBarWidth(m.download);
      return (
        <div class="metric-row">
          <div class="metric-info-line">
            <span class="node-name">
              <span class="status-ping-dot" style={`background-color: ${color}; box-shadow: 0 0 6px ${color};`}></span>
              {m.location}
            </span>
            <div class="metric-data-values">
              <span class="latency-val" style={`color: ${color};`}>延迟: {m.latency}</span>
              <span class="download-val">速率: {m.download}</span>
            </div>
          </div>
          <div class="progress-track">
            <div class="progress-fill" style={`width: ${width}%; background: linear-gradient(90deg, #0284c7 0%, ${color} 100%);`}></div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Lightbox trigger prompt if image available -->
  {imageSrc && (
    <div class="terminal-footer">
      <span>💡 点击下方测速大图可使用 PhotoSwipe 全屏高解析度放大查验原始测速截图</span>
    </div>
  )}
</div>

<style>
  .noc-terminal-box {
    background: #0b1120;
    border: 1px solid #1e293b;
    border-radius: 8px;
    overflow: hidden;
    font-family: var(--font-mono);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    margin: 1.5rem 0;
  }

  .terminal-bar {
    background: #030712;
    padding: 0.6rem 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #1e293b;
  }

  .window-controls {
    display: flex;
    gap: 6px;
  }

  .ctrl-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .ctrl-dot.red { background: #ef4444; }
  .ctrl-dot.yellow { background: #f59e0b; }
  .ctrl-dot.green { background: #10b981; }

  .terminal-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: #e2e8f0;
    letter-spacing: 0.03em;
  }

  .terminal-badge {
    font-size: 0.68rem;
    padding: 0.1rem 0.4rem;
    background: rgba(16, 185, 129, 0.2);
    border: 1px solid #10b981;
    color: #10b981;
    border-radius: 3px;
    font-weight: 700;
  }

  .terminal-sub {
    background: #0f172a;
    padding: 0.45rem 0.85rem;
    font-size: 0.72rem;
    color: #94a3b8;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    border-bottom: 1px solid #1e293b;
  }

  .metric-list {
    padding: 1rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .metric-row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .metric-info-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
  }

  .node-name {
    color: #f8fafc;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .status-ping-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .metric-data-values {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
  }

  .latency-val {
    font-weight: 600;
  }

  .download-val {
    color: #38bdf8;
    font-weight: 700;
  }

  .progress-track {
    width: 100%;
    height: 6px;
    background: #1e293b;
    border-radius: 3px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    border-radius: 3px;
    transition: width 0.6s ease;
  }

  .terminal-footer {
    background: #030712;
    padding: 0.4rem 0.85rem;
    font-size: 0.7rem;
    color: #64748b;
    border-top: 1px solid #1e293b;
    text-align: center;
  }
</style>
