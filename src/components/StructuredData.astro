---
import { siteConfig } from '../config/site';

interface Props {
  type?: 'website' | 'article';
  title?: string;
  description?: string;
  datePublished?: Date;
  dateModified?: Date;
  tags?: string[];
  url?: string;
}

const {
  type = 'website',
  title = siteConfig.title,
  description = siteConfig.description,
  datePublished,
  dateModified,
  tags = [],
  url = siteConfig.siteUrl,
} = Astro.props;

const baseUrl = (siteConfig.siteUrl || 'https://flybit.fun').replace(/\/$/, '');

const schema =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: description,
        url: url,
        datePublished: datePublished?.toISOString(),
        dateModified: (dateModified || datePublished)?.toISOString(),
        author: {
          '@type': 'Person',
          name: siteConfig.author,
        },
        publisher: {
          '@type': 'Organization',
          name: siteConfig.title,
          url: baseUrl,
        },
        keywords: tags.join(', '),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteConfig.title,
        description: siteConfig.description,
        url: baseUrl,
        author: {
          '@type': 'Person',
          name: siteConfig.author,
        },
      };

const breadcrumbSchema =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: '首页',
            item: `${baseUrl}/`,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: '专题指南',
            item: `${baseUrl}/blog/`,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: title,
            item: url,
          },
        ],
      }
    : null;
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
{breadcrumbSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
