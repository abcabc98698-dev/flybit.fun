---
// src/components/AirportCard.astro
// Ultra-Refined Network Observatory Airport Card
import type { AirportBrand } from '../data/airports';

interface Props {
  brand: AirportBrand;
  featured?: boolean;
}

const { brand, featured = false } = Astro.props;
const isTop1 = brand.rank === 1;

// Clean alias: only show if distinct from Chinese name
const showAlias = brand.alias &&
  brand.alias.toLowerCase() !== brand.name.toLowerCase() &&
  !brand.name.toLowerCase().includes(brand.alias.toLowerCase());

// Clean formatted price without extra spaces (e.g. "¥8 / 月" -> "¥8/月")
const formattedPrice = brand.entryPrice.replace(/\s*\/\s*/g, '/');
---

<div class:list={['airport-card', { featured: featured || isTop1, archive: brand.tier === 'archive' }]} data-rank={brand.rank} data-price={brand.minMonthlyPrice} data-has-speedtest={brand.speedtestImage ? 'true' : 'false'}>
  
  <!-- Row 1: Header Bar (Rank + Status on Left, Price Badge on Right) -->
  <div class="card-top-bar">
    <div class="top-meta-left">
      <span class:list={['rank-badge', { 'rank-top1': isTop1, 'rank-top10': brand.rank > 1 && brand.rank <= 10 }]}>
        #{String(brand.rank).padStart(2, '0')}
      </span>
      <span class="status-indicator">
        <span class="pulse-dot"></span>
        <span class="status-txt">{brand.dataStatus === 'measured' ? '晚高峰已实测' : (brand.dataStatus === 'historical' ? '历史档案' : '运营中')}</span>
      </span>
    </div>

    <div class="price-badge">
      <span class="price-label">起步</span>
      <span class="price-val">{formattedPrice}</span>
    </div>
  </div>

  <!-- Row 2: Brand Title + Year (Full Width) -->
  <div class="brand-title-wrap">
    <h3 class="brand-name">
      <a href={`/brands/${brand.id}`} class="brand-link">
        {brand.name}
      </a>
      {showAlias && <span class="brand-alias">({brand.alias})</span>}
    </h3>
    {brand.startedYear && brand.startedYear !== '待核实' && brand.startedYear !== '历史收录' && (
      <span class="year-tag">{brand.startedYear} 运营</span>
    )}
  </div>

  <!-- Row 3: Tech Specs Row (Lines + Protocols + Speedtest Tag) -->
  <div class="specs-row">
    <div class="spec-chip line-chip" title="传输骨干网络">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
      <span>{brand.lines}</span>
    </div>
    {brand.protocols.slice(0, 2).map((proto) => (
      <span class="spec-chip proto-chip">{proto}</span>
    ))}
    {brand.speedtestImage && (
      <a href={`/brands/${brand.id}#speedtest`} class="spec-chip speedtest-chip" title="点击查看测速大图">
        ⚡ 含实测图
      </a>
    )}
  </div>

  <!-- Row 4: Highlight / Selling Point -->
  <p class="brand-desc">
    {brand.features[0] || brand.description.slice(0, 60) + '...'}
  </p>

  <!-- Row 5: Speed Metric Mini Bars (If measured) -->
  {brand.speedtests && brand.speedtests.length > 0 && (
    <div class="metric-preview">
      {brand.speedtests.slice(0, 3).map((m) => (
        <div class="metric-item">
          <span class="metric-loc">{m.location}</span>
          <span class="metric-ping">{m.latency}</span>
          <span class="metric-speed">{m.download}</span>
        </div>
      ))}
    </div>
  )}

  <!-- Row 6: Streaming & Unlock Chips -->
  <div class="unlock-chips">
    <span class="unlock-tag">🎬 Netflix 4K</span>
    <span class="unlock-tag">🤖 ChatGPT 5</span>
    <span class="unlock-tag">✨ Claude 3.5</span>
    <span class="unlock-tag">📺 YouTube 4K</span>
  </div>

  <!-- Row 7: Coupon Box (If available) -->
  {brand.coupon && (
    <div class="coupon-banner">
      <div class="coupon-info">
        <span class="coupon-label">优惠码:</span>
        <code class="coupon-code" id={`code-${brand.id}`}>{brand.coupon}</code>
      </div>
      <button
        type="button"
        class="copy-btn"
        data-clipboard={brand.coupon}
        title="点击复制优惠码"
        onclick={`navigator.clipboard.writeText('${brand.coupon}').then(() => { this.innerText = '已复制!'; setTimeout(() => this.innerText = '复制', 2000); })`}
      >
        复制
      </button>
    </div>
  )}

  <!-- Row 8: Action Footer -->
  <div class="card-footer">
    <a href={`/brands/${brand.id}`} class="btn-detail">
      评测详情 →
    </a>

    {brand.affLink ? (
      <div class="aff-btn-wrap">
        <a
          href={brand.affLink}
          target="_blank"
          rel="nofollow sponsored noopener"
          class:list={['btn-aff', { 'btn-aff-featured': isTop1 }]}
          title={`进入 ${brand.name} 官网（外链含推广）`}
        >
          {isTop1 ? '🚀 直通光速云官网' : '直达官网 →'}
        </a>
      </div>
    ) : (
      <span class="btn-archived">官网待更新</span>
    )}
  </div>

  <!-- Row 9: Affiliate Disclosure Note -->
  <div class="aff-note">
    <span>🛡️ 商业透明说明：外链含推广分成，优惠码享立减，不影响独立实测</span>
  </div>
</div>

<style>
  .airport-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.15rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    position: relative;
    box-sizing: border-box;
    min-width: 0;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .airport-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .airport-card.featured {
    border-color: var(--accent);
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-subtle) 100%);
    box-shadow: 0 0 0 1px var(--accent), 0 8px 24px rgba(56, 189, 248, 0.12);
  }

  .airport-card.archive {
    opacity: 0.9;
  }

  /* Row 1: Top Bar */
  .card-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    min-height: 24px;
  }

  .top-meta-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
    min-width: 0;
  }

  .rank-badge {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: var(--bg-subtle);
    color: var(--text-muted);
    border: 1px solid var(--border);
    white-space: nowrap;
    line-height: 1.2;
  }

  .rank-top1 {
    background: #0284c7;
    color: #ffffff;
    border-color: #38bdf8;
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.3);
  }

  .rank-top10 {
    background: var(--bg-subtle);
    color: var(--accent);
    border-color: var(--accent);
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    display: inline-block;
    box-shadow: 0 0 6px #10b981;
    flex-shrink: 0;
  }

  .status-txt {
    white-space: nowrap;
  }

  .price-badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .price-label {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .price-val {
    font-size: 1.05rem;
    font-weight: 800;
    color: #10b981;
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  /* Row 2: Brand Title + Year */
  .brand-title-wrap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.1rem;
  }

  .brand-name {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.3;
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-link {
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .brand-link:hover {
    color: var(--accent);
  }

  .brand-alias {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 400;
    white-space: nowrap;
  }

  .year-tag {
    font-size: 0.72rem;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Row 3: Specs */
  .specs-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .spec-chip {
    font-size: 0.72rem;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .line-chip {
    color: var(--text);
    font-weight: 600;
    border-color: var(--border);
    background: var(--bg-subtle);
  }

  .speedtest-chip {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.3);
    text-decoration: none;
    font-weight: 600;
  }

  /* Row 4: Description */
  .brand-desc {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--text-muted);
    min-height: 1.45em;
  }

  /* Row 5: Metric Preview */
  .metric-preview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.35rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    white-space: nowrap;
  }

  .metric-loc {
    color: var(--text-muted);
    font-size: 0.65rem;
  }

  .metric-ping {
    color: #10b981;
    font-weight: 700;
  }

  .metric-speed {
    color: var(--text);
    font-size: 0.65rem;
  }

  /* Row 6: Unlock Chips */
  .unlock-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .unlock-tag {
    font-size: 0.7rem;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    background: var(--bg-subtle);
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* Row 7: Coupon Banner */
  .coupon-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(56, 189, 248, 0.08);
    border: 1px dashed var(--accent);
    border-radius: 6px;
    padding: 0.35rem 0.6rem;
    font-size: 0.8rem;
    gap: 0.5rem;
    min-width: 0;
  }

  .coupon-info {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    min-width: 0;
  }

  .coupon-label {
    color: var(--text-muted);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .coupon-code {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .copy-btn {
    background: var(--accent);
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 0.2rem 0.55rem;
    font-size: 0.72rem;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }

  .copy-btn:hover {
    opacity: 0.85;
  }

  /* Row 8: Action Footer */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.45rem;
    border-top: 1px solid var(--border);
  }

  .btn-detail {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .btn-detail:hover {
    color: var(--accent);
  }

  .aff-btn-wrap {
    display: flex;
    flex-shrink: 0;
  }

  .btn-aff {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 0.3rem 0.7rem;
    border-radius: 5px;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .btn-aff:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: #ffffff;
  }

  .btn-aff-featured {
    background: #0284c7;
    color: #ffffff;
    border-color: #38bdf8;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.25);
  }

  .btn-aff-featured:hover {
    background: #0369a1;
  }

  .btn-archived {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-style: italic;
    white-space: nowrap;
  }

  /* Row 9: Disclosure */
  .aff-note {
    font-size: 0.68rem;
    color: var(--text-muted);
    opacity: 0.8;
    line-height: 1.35;
    text-align: center;
  }
</style>
