---
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const comments = siteConfig.comments;
const isEnabled = siteConfig.features?.comments !== false && Boolean(comments?.enabled);
---

{isEnabled && (
  <section class="comments-area" id="comments" aria-label="Article Discussion">
    <div class="comments-divider"></div>

    <div class="comments-wrapper">
      <div class="comments-header">
        <h3 class="comments-title">
          <span>💬</span>
          <span>Discussion &amp; Feedback</span>
        </h3>
        <p class="comments-subtitle">
          Have questions, thoughts, or perspectives on this article? Join the discussion with the engineering community.
        </p>
      </div>

      <div class="comments-actions">
        {siteConfig.socialLinks.github && (
          <a
            href={siteConfig.socialLinks.github}
            target="_blank"
            rel="noopener noreferrer"
            class="comments-btn"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            Discuss on GitHub
          </a>
        )}
        {siteConfig.socialLinks.email && (
          <a
            href={`mailto:${siteConfig.socialLinks.email}?subject=Feedback:%20${encodeURIComponent(title || '')}`}
            class="comments-btn comments-btn-secondary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            Send Email
          </a>
        )}
      </div>

      <slot />
    </div>
  </section>
)}

<style>
  .comments-area {
    margin-top: 3.5rem;
  }

  .comments-divider {
    height: 1px;
    background: var(--border);
    margin-bottom: 2.5rem;
  }

  .comments-header {
    margin-bottom: 1.5rem;
  }

  .comments-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
    color: var(--text);
  }

  .comments-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .comments-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .comments-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background-color: var(--bg-surface);
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .comments-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--bg-subtle);
    transform: translateY(-1px);
  }

  .comments-btn-secondary {
    background-color: transparent;
  }
</style>
