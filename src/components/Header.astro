---
// src/components/Header.astro
// Global Top Navigation Header with responsive NOC styling
import { siteConfig } from '../config/site';
import ThemeSelector from './ThemeSelector.astro';
import SocialDropdown from './SocialDropdown.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const features = siteConfig.features ?? {};
const showSearch = features.search !== false;
const showThemeSwitcher = features.themeSwitcher !== false;
---

<header class="site-header">
  <div class="container-wide header-inner">
    <!-- Brand Title -->
    <a href="/" class="brand" aria-label="Flybit Home">
      <span class="brand-rock">⚡</span>
      <span class="brand-title">{siteConfig.title}</span>
    </a>

    <!-- Main Navigation Bar -->
    <nav class="nav" aria-label="Main Navigation">
      {siteConfig.navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        const isHighlight = link.href === '/free';
        return (
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive, highlight: isHighlight }]}
            aria-current={isActive ? 'page' : undefined}
          >
            {isHighlight && <span class="nav-badge-dot" aria-hidden="true"></span>}
            <span>{link.title}</span>
            {isHighlight && <span class="nav-hot-tag" aria-hidden="true">HOT</span>}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Search Trigger (Desktop) -->
      {showSearch && (
        <button id="header-search-btn" class="search-trigger desktop-only" type="button" aria-label="搜索 (Ctrl + K)" title="搜索 (Ctrl + K)">
          <div class="search-trigger-inner">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <span class="search-trigger-text">搜索...</span>
          </div>
          <kbd class="search-trigger-kbd">Ctrl K</kbd>
        </button>
      )}

      <!-- Mobile Search Button -->
      {showSearch && (
        <button id="mobile-search-btn" class="icon-btn mobile-only" type="button" aria-label="Search" title="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </button>
      )}

      <!-- Clustered Controls: Social + Theme Dropdowns -->
      <div class="header-controls">
        <SocialDropdown />
        {showThemeSwitcher && <ThemeSelector />}
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
    margin-bottom: 2rem;
    background: var(--bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--text);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .brand-rock {
    font-size: 1.35rem;
    line-height: 1;
  }

  .brand-title {
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .nav-link.active {
    color: var(--accent);
    background: rgba(56, 189, 248, 0.1);
    font-weight: 600;
  }

  .nav-link.highlight {
    color: #38bdf8;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-badge-dot {
    width: 6px;
    height: 6px;
    background-color: #10b981;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 6px #10b981;
    animation: navPulse 2s infinite ease-in-out;
  }

  .nav-hot-tag {
    font-size: 0.62rem;
    font-weight: 800;
    line-height: 1;
    padding: 0.12rem 0.3rem;
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #ffffff;
    border-radius: 3px;
    letter-spacing: 0.04em;
    box-shadow: 0 1px 3px rgba(239, 68, 68, 0.3);
  }

  @keyframes navPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.8); }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Search Trigger */
  .search-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.35rem 0.65rem;
    min-width: 130px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.85rem;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .search-trigger-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .search-trigger:hover {
    border-color: var(--accent);
    color: var(--text);
    background-color: var(--bg-subtle);
  }

  .search-trigger-kbd {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background-color: var(--bg);
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background-color: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    padding: 0;
  }

  .icon-btn:hover {
    color: var(--text);
    border-color: var(--accent);
    background-color: var(--bg-subtle);
  }

  .desktop-only {
    display: inline-flex;
  }

  .mobile-only {
    display: none;
  }

  @media (max-width: 980px) {
    .desktop-only {
      display: none;
    }
    .mobile-only {
      display: inline-flex;
    }
    .nav {
      gap: 0.6rem;
    }
    .nav-link {
      font-size: 0.88rem;
      padding: 0.2rem 0.35rem;
    }
  }

  @media (max-width: 768px) {
    .header-inner {
      flex-wrap: wrap;
      row-gap: 0.75rem;
    }

    .nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.25rem;
      scrollbar-width: none;
    }
    .nav::-webkit-scrollbar {
      display: none;
    }

    .header-actions {
      margin-left: auto;
    }
  }
</style>
